{
  "name": "bare-host-parser",
  "version": "1.0.0",
  "description": "Parse and format Bare host identifiers",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./errors": "./lib/errors.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:bare && npm run test:node",
    "test:bare": "brittle-bare --coverage test.js",
    "test:node": "brittle-node --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-host-parser.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-host-parser/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-host-parser#readme",
  "devDependencies": {
    "brittle": "^4.5.0",
    "lunte": "^1.8.6",
    "prettier": "^3.9.10",
    "prettier-config-holepunch": "^2.0.0"
  }
}
